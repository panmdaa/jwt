{
	"name": "@panmdaa/server",
	"private": false,
	"version": "0.2.1",
	"description": "Zero-dependency TypeScript HTTP and WebSocket server with a compiled-radix router, built on Node's native http, https and http2 transport",
	"license": "MIT",
	"author": {
		"name": "Panmdaa",
		"email": "is.kkokotero@gmail.com",
		"url": "https://github.com/panmdaa"
	},
	"keywords": [
		"panmdaa",
		"http",
		"http2",
		"websocket",
		"server",
		"router",
		"radix-tree",
		"typescript",
		"zero-dependencies"
	],
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"prepare": "tsup && tsc -p tsconfig.build.json",
		"build": "node scripts/run-all.mjs && tsup && tsc -p tsconfig.build.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint --write .",
		"format": "biome format --write .",
		"bench": "npm --prefix bench run bench",
		"bench:router": "npm --prefix bench run bench:router",
		"bench:http": "npm --prefix bench run bench:http",
		"bench:http:post": "npm --prefix bench run bench:http:post",
		"bench:middleware": "npm --prefix bench run bench:middleware",
		"bench:parse": "npm --prefix bench run bench:parse",
		"bench:ws": "npm --prefix bench run bench:ws"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/panmdaa/server.git"
	},
	"homepage": "https://github.com/panmdaa/server#readme",
	"bugs": {
		"url": "https://github.com/panmdaa/server/issues"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"files": [
		"dist",
		"misc",
		"LICENSE",
		"README.md"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/node": "^22.15.0",
		"mime-db": "^1.54.0",
		"tsup": "^8.4.0",
		"typescript": "^7.0.2",
		"vitest": "^3.2.7"
	}
}
