{
	"name": "@panmdaa/server-bench",
	"private": true,
	"version": "0.1.0",
	"description": "Benchmarks for @panmdaa/server vs other Node HTTP/WebSocket libraries",
	"type": "module",
	"scripts": {
		"bench": "vitest bench",
		"bench:http": "tsx src/http-bench.ts",
		"bench:http:post": "tsx src/http-post-bench.ts",
		"bench:middleware": "vitest bench src/middleware.bench.ts",
		"bench:parse": "vitest bench src/parse.bench.ts",
		"bench:router": "vitest bench src/router.bench.ts",
		"bench:ws": "tsx src/ws-bench.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint --write .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@fastify/websocket": "^11.3.0",
		"@hono/node-server": "^2.1.0",
		"@types/express": "^5.0.6",
		"@types/node": "^22.20.1",
		"@types/ws": "^8.18.1",
		"autocannon": "^8.0.0",
		"elysia": "^1.4.29",
		"express": "^5.2.1",
		"express-ws": "^5.0.2",
		"fastify": "^5.11.3",
		"find-my-way": "^9.7.0",
		"hono": "^4.13.1",
		"tsx": "^4.23.11",
		"typescript": "^7.0.2",
		"vitest": "^3.2.7",
		"ws": "^8.21.3"
	}
}
